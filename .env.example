# WebBookTracker AI Configuration
# Copy this file to .env and fill in your API keys

# Google Gemini API Key (Required for AI query enhancement)
# Get your free API key at: https://makersuite.google.com/app/apikey
# Free tier: 1,500 requests per day
GEMINI_API_KEY=your_gemini_api_key_here

# Hugging Face API Token (Optional - for better embeddings)
# Get your free token at: https://huggingface.co/settings/tokens
# Free tier: 30,000 requests per month
HF_API_KEY=your_huggingface_token_here

# Cohere API Key (Optional - for result reranking)
# Get your free API key at: https://dashboard.cohere.com/api-keys
# Free tier: 100 requests per day
COHERE_API_KEY=your_cohere_api_key_here

# Database Configuration (Keep your existing values)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=web_book_tracker

# Server Configuration
PORT=3000
SESSION_SECRET=your_session_secret_here

# Google Books API (Optional - for better rate limits)
# Get key at: https://console.cloud.google.com/apis/credentials
GOOGLE_BOOKS_API_KEY=your_google_books_api_key_here
