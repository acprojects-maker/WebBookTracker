# ===================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ===================================
# Copy this file and set these variables in your hosting platform's dashboard
# DO NOT commit actual values to version control!

# -----------------
# Server Configuration
# -----------------
NODE_ENV=production
PORT=10000
# Your frontend URL (e.g., https://yourdomain.com or https://yourapp.vercel.app)
APP_URL=https://your-frontend-url.vercel.app

# -----------------
# Security
# -----------------
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-long-random-jwt-secret-at-least-64-characters-long

# -----------------
# Database (PlanetScale MySQL)
# -----------------
# Get these from your PlanetScale dashboard after creating a database
DB_HOST=your-database.connect.psdb.cloud
DB_USER=your-planetscale-username
DB_PASSWORD=your-planetscale-password
DB_NAME=booktracker
DB_SSL=true

# -----------------
# Email Service (Brevo SMTP)
# -----------------
# Get these from Brevo dashboard: Settings > SMTP & API
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-brevo-smtp-key
EMAIL_FROM=Book Tracker <noreply@yourdomain.com>

# -----------------
# AI API Keys
# -----------------
# Google Gemini API (https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Hugging Face API (https://huggingface.co/settings/tokens)
HF_API_KEY=your-huggingface-api-key

# Cohere API (https://dashboard.cohere.com/api-keys)
COHERE_API_KEY=your-cohere-api-key

# Google Books API (https://console.cloud.google.com/apis/credentials)
GOOGLE_BOOKS_API_KEY=your-google-books-api-key

# -----------------
# DEPLOYMENT NOTES
# -----------------
# For Render: Set these in Dashboard > Environment tab
# For Railway: Set these in Service > Variables tab
# For Vercel (frontend only): Not needed - frontend uses config.js
#
# SECURITY CHECKLIST:
# ✓ Never commit this file with real values
# ✓ Use different API keys for production vs development
# ✓ Rotate JWT_SECRET if it's ever exposed
# ✓ Monitor API key usage for unusual activity
# ✓ Enable 2FA on all service accounts
